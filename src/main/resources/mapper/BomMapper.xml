<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.itwillbs.ilkwangtech.standard.mapper.BomMapper">

    <resultMap id="BomResultMap" type="com.itwillbs.ilkwangtech.standard.dto.ParentItemDTO">
        <id property="itemId" column="itemId" />
        <result property="code" column="code" />
        <result property="name" column="name" />
        <result property="unit" column="unit" />
    </resultMap>

    <select id="selectBomList" resultMap="BomResultMap">
        select
            I.item_id as item_id,
            I.item_code as code,
            I.item_name as name,
            B.require_qty as unit
        from bom B
        join item I on B.parent_item_id = I.item_id
        where B.child_item_id = #{childItemId}
    </select>

</mapper>
