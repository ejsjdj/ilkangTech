<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.itwillbs.ilkwangtech.standard.mapper.ItemMapper">

    <!-- ItemDTO ResultMap -->
    <resultMap id="ItemResultMap" type="com.itwillbs.ilkwangtech.item.dto.ItemDTO">
        <id property="id" column="id"/>
        <result property="itemCode" column="item_code"/>
        <result property="type" column="type" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler"/>
        <result property="company_id" column="company_id"/>
        <result property="description" column="description"/>
    </resultMap>

    <!-- 품목 등록 -->
    <insert id="insertItem" parameterType="com.itwillbs.ilkwangtech.item.dto.ItemDTO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO item (
            item_code,
            type,
            company_id,
            description
        ) VALUES (
            #{itemCode},
            #{type},
            #{company_id},
            #{description}
        )
    </insert>

</mapper>